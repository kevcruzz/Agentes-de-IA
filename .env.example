# ─── OBRIGATÓRIO ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ─── MODELO (opcional — padrão já configurado) ───────────────────────────────
MODEL=claude-sonnet-4-20250514
MAX_TOKENS=2048
MAX_ITERATIONS=15
TIMEOUT_SECONDS=30

# ─── LOGS ────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── BANCO DE DADOS (opcional — SQLite por padrão) ───────────────────────────
# Para PostgreSQL em produção:
# DATABASE_URL=postgresql://user:password@localhost:5432/agentes
DATABASE_URL=sqlite:///./agentes.db
